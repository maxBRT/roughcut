{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Roughcut",
  "version": "0.1.1",
  "identifier": "app.roughcut.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Roughcut",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "backgroundColor": "#1B1B19"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ3NjhDRTZFRTRENzMyNDAKUldSQU10ZmticzVvUjBVVnU3eCtTYU5pcE92eEswZzN2ZkF3NzNla2lzeXR6WFZtWjhEV1R5ZDEK",
      "endpoints": ["https://github.com/maxBRT/roughcut/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
